---
// Layout base: estructura HTML para todas las páginas
// Recibe una "title" (título de la página) como prop opcional
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Portfolio de Agustina Ferraro - Diseñadora Multimedia & Desarrolladora Full Stack"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ?? 'Agustina Ferraro | Diseñadora Multimedia'}</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 font-sans antialiased">
		<slot />
	</body>
</html>

<style>
	html {
		scroll-behavior: smooth;
	}
	html,
	body {
		margin: 0;
		width: 100%;
	}
	body {
		min-height: 100%;
	}
</style>