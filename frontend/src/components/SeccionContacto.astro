---
// Sección de Contacto
// La parte estática (título y redes) vive en este .astro
// El formulario en sí es un componente React (client:load) con estados
import FormularioContacto from './FormularioContacto.jsx';

const canales = [
  { href: '#', texto: 'LinkedIn' },
  { href: '#', texto: 'GitHub' },
  { href: '#', texto: 'Behance' },
  { href: '#', texto: '@multimediagus' },
];
---

<section id="contacto" class="py-24 px-4">
  <div class="max-w-2xl mx-auto text-center space-y-8">
    <div class="space-y-6">
      <h2 class="text-3xl font-bold text-white">Contacto</h2>
      <p class="text-zinc-400 leading-relaxed">
        ¿Tenés un proyecto en mente? Escribime y te respondo a la brevedad.
      </p>
    </div>

    <FormularioContacto client:load />

    <address class="not-italic">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-zinc-300">
        {
          canales.map((canal) => (
            <li>
              <a href={canal.href} class="hover:text-white transition-colors">
                {canal.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </address>
  </div>
</section>