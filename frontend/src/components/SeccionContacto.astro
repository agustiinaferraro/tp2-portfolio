---
// Sección de Contacto
// Por ahora es un placeholder; en la Etapa 2 se reemplaza por un formulario
// Las URL de las redes se completan cuando estén definidas
const canales = [
  { href: '#', texto: 'LinkedIn' },
  { href: '#', texto: 'GitHub' },
  { href: '#', texto: 'Behance' },
  { href: '#', texto: '@multimediagus' },
];
---

<section id="contacto" class="py-24 px-4">
  <div class="max-w-2xl mx-auto text-center space-y-6">
    <h2 class="text-3xl font-bold text-white">Contacto</h2>
    <p class="text-zinc-400 leading-relaxed">
      Esta sección estará lista en la Etapa 2. Por ahora, podés escribirme por mail o redes.
    </p>
    <address class="not-italic">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-zinc-300">
        {
          canales.map((canal) => (
            <li>
              <a href={canal.href} class="hover:text-white transition-colors">
                {canal.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </address>
  </div>
</section>