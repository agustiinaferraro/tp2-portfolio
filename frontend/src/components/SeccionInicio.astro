---
//seccion de inicio (hero): presentacion principal del portfolio
//es estatica, por eso es un componente astro (no manda javascript al navegador)
---

<section id="inicio" class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4">
  <div class="max-w-3xl mx-auto text-center space-y-6">
    <p class="text-indigo-400 font-medium tracking-widest uppercase text-sm">
      Agustina Ferraro
    </p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
      Diseñadora Multimedia <span class="text-indigo-400">&amp;</span> Desarrolladora Full Stack
    </h1>
    <p class="text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
      Diseño experiencias digitales, interfaces e interacciones donde la tecnología y la
      estética conectan con las personas.
    </p>
    <div class="flex flex-wrap gap-4 justify-center pt-2">
      <a
        href="/proyectos"
        class="px-6 py-3 rounded-full bg-indigo-600 hover:bg-indigo-500 hover:scale-105 active:scale-95 active:bg-indigo-400 transition-all duration-200 font-medium"
      >
        Ver proyectos
      </a>
      <a
        href="/contacto"
        class="px-6 py-3 rounded-full border border-zinc-700 hover:border-zinc-500 hover:text-white hover:scale-105 active:scale-95 active:bg-zinc-700 active:border-zinc-500 transition-all duration-200 font-medium text-zinc-300"
      >
        Contactame
      </a>
    </div>
  </div>
</section>
