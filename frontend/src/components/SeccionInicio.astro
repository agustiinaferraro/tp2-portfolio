---
//seccion de inicio (hero): presentacion principal del portfolio
//el carrusel de videos queda de fondo y la presentacion encima
//el resto es estatico, asi que es un componente astro (no manda javascript al navegador)
import HeroCarrusel from './HeroCarrusel.jsx';
---

<section id="inicio" class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 overflow-hidden">
  {/*los proyectos en video pasan de fondo, detras de la presentacion*/}
  <div class="absolute inset-0 -z-10">
    <HeroCarrusel client:load />
  </div>
  {/*velo suave para que el texto se lea siempre sobre el video*/}
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-gradient-to-b from-black/70 via-black/55 to-black/70"
  >
  </div>

  <div class="max-w-3xl mx-auto text-center space-y-6">
    <p class="text-verde-app font-medium tracking-widest uppercase text-sm">
      Agustina Ferraro
    </p>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
      Diseñadora Multimedia <span class="text-verde-app">&amp;</span> Desarrolladora Full Stack
    </h1>
    <p class="text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
      Diseño experiencias digitales, interfaces e interacciones donde la tecnología y la
      estética conectan con las personas.
    </p>
    <div class="flex flex-wrap gap-4 justify-center pt-2">
      <a
        href="/proyectos"
        class="px-6 py-3 rounded-full bg-violeta-app hover:bg-violeta-app/90 hover:scale-105 active:scale-95 active:bg-violeta-app/80 transition-all duration-200 font-medium text-black"
      >
        Ver proyectos
      </a>
      <a
        href="/contacto"
        class="px-6 py-3 rounded-full border border-zinc-700 hover:border-zinc-500 hover:text-white hover:scale-105 active:scale-95 active:bg-zinc-700 active:border-zinc-500 transition-all duration-200 font-medium text-zinc-300"
      >
        Contactame
      </a>
    </div>
  </div>
</section>
