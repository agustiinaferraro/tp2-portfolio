---
//seccion de proyectos: marco y titulo (estaticos)
//la grilla con los datos dinamicos vive en grillaproyectos.jsx (isla de react)
import GrillaProyectos from './GrillaProyectos.jsx';
---

<section id="proyectos" class="py-24 px-4">
  <div class="max-w-6xl mx-auto space-y-10">
    <div class="text-left space-y-3">
      <h2 class="text-4xl font-bold text-white inline-flex items-center gap-3">
        <svg
          aria-hidden="true"
          class="w-9 h-9 text-indigo-400"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
          />
        </svg>
        Proyectos
      </h2>
      <p class="text-zinc-400 max-w-xl mx-auto">
        Una selección de mis trabajos. Cargados dinámicamente desde la base de datos.
      </p>
    </div>
    <GrillaProyectos client:load />
  </div>
</section>
