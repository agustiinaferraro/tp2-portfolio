---
//seccion de servicios: marco y titulo (estaticos)
//la grilla con los datos dinamicos vive en grillaservicios.jsx (isla de react)
import GrillaServicios from './GrillaServicios.jsx';
---

<section id="servicios" class="py-24 px-4 bg-zinc-900/40 border-y border-zinc-800/50">
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="text-left space-y-4">
      <h2 class="text-4xl font-bold text-white inline-flex items-center gap-3">
        <svg
          aria-hidden="true"
          class="w-9 h-9 text-verde-app"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.27 6.96 12 12.01l8.73-5.05" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 22.08V12" />
        </svg>
        Servicios
      </h2>
      <p class="text-zinc-400">
        Lo que puedo ofrecerte para llevar tu proyecto del concepto al resultado.
      </p>
    </div>
    <GrillaServicios client:load />
  </div>
</section>
