---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SeccionInicio from '../components/SeccionInicio.astro';
import HeroCarrusel from '../components/HeroCarrusel.jsx';
import Saludo from '../components/Saludo.jsx';
import SeccionSobreMi from '../components/SeccionSobreMi.astro';
import SeccionProyectos from '../components/SeccionProyectos.astro';
import SeccionServicios from '../components/SeccionServicios.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main id="contenido" class="pt-16">
    <SeccionInicio />
    <HeroCarrusel client:load />
    <Saludo client:load />
    <SeccionSobreMi />
    <SeccionProyectos />
    <SeccionServicios />
    <SeccionContacto />
  </main>
  <Footer />
</Layout>
