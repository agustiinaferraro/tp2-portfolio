---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SeccionServicios from '../components/SeccionServicios.jsx';
import SeccionProyectos from '../components/SeccionProyectos.jsx';
import '../styles/global.css';
---

<Layout>
  <Navbar />

  <main class="pt-16">
    <!-- ===== SECCIÓN INICIO (Hero) ===== -->
    <section id="inicio" class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <p class="text-indigo-400 font-medium tracking-widest uppercase text-sm">
          Agustina Ferraro · Multimediagus
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
          Diseñadora Multimedia <span class="text-indigo-400">&amp;</span> Desarrolladora Full Stack
        </h1>
        <p class="text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
          Diseño experiencias digitales, interfaces e interacciones donde la tecnología y la
          estética conectan con las personas.
        </p>
        <div class="flex flex-wrap gap-4 justify-center pt-2">
          <a
            href="#proyectos"
            class="px-6 py-3 rounded-full bg-indigo-600 hover:bg-indigo-500 transition-colors font-medium"
          >
            Ver proyectos
          </a>
          <a
            href="#contacto"
            class="px-6 py-3 rounded-full border border-zinc-700 hover:border-zinc-500 hover:text-white text-zinc-300 transition-colors font-medium"
          >
            Contactame
          </a>
        </div>
      </div>
    </section>

    <!-- ===== SECCIÓN SOBRE MÍ ===== -->
    <section id="sobre-mi" class="py-24 px-4 bg-zinc-900/40 border-y border-zinc-800/50">
      <div class="max-w-4xl mx-auto space-y-6">
        <h2 class="text-3xl font-bold text-white text-center">Sobre mí</h2>
        <div class="space-y-4 text-zinc-300 leading-relaxed text-lg text-center max-w-3xl mx-auto">
          <p>
            Soy <strong class="text-white">Diseñadora Multimedia</strong>. Mi trabajo abarca todo
            el proceso de un proyecto digital: desde la identidad visual y el diseño de experiencia
            (UX/UI), hasta el desarrollo del código, la animación y la edición audiovisual.
          </p>
          <p>
            Tener una formación integral me permite entender los proyectos de manera global. Puedo
            proyectar cómo se ve y se siente una interfaz, cómo se estructura técnicamente por
            dentro y cómo comunicarla a través del lenguaje audiovisual.
          </p>
          <p>
            Me interesa crear productos <strong class="text-white">funcionales</strong>,
            correctamente diseñados y técnicamente sólidos.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== SECCIÓN PROYECTOS ===== -->
    <section id="proyectos" class="py-24 px-4">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="text-center space-y-3">
          <h2 class="text-3xl font-bold text-white">Proyectos</h2>
          <p class="text-zinc-400 max-w-xl mx-auto">
            Una selección de mis trabajos. Cargados dinámicamente desde la base de datos.
          </p>
        </div>
        <SeccionProyectos client:load />
      </div>
    </section>

    <!-- ===== SECCIÓN SERVICIOS ===== -->
    <section id="servicios" class="py-24 px-4 bg-zinc-900/40 border-y border-zinc-800/50">
      <div class="max-w-6xl mx-auto space-y-10">
        <div class="text-center space-y-3">
          <h2 class="text-3xl font-bold text-white">Servicios</h2>
          <p class="text-zinc-400 max-w-xl mx-auto">
            Lo que puedo ofrecerte para llevar tu proyecto del concepto al resultado.
          </p>
        </div>
        <SeccionServicios client:load />
      </div>
    </section>

    <!-- ===== SECCIÓN CONTACTO (placeholder por ahora) ===== -->
    <section id="contacto" class="py-24 px-4">
      <div class="max-w-2xl mx-auto text-center space-y-6">
        <h2 class="text-3xl font-bold text-white">Contacto</h2>
        <p class="text-zinc-400 leading-relaxed">
          Esta sección estará lista en la Etapa 2. Por ahora, podés escribirme por mail o redes.
        </p>
        <p class="text-zinc-300">
          LinkedIn · GitHub · Behance · @multimediagus
        </p>
      </div>
    </section>
  </main>
</Layout>