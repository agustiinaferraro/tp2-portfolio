---
//pagina "sobre mi": reusa la seccion del home
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BackButton from '../components/BackButton.astro';
import SeccionSobreMi from '../components/SeccionSobreMi.astro';
---

<Layout title="Sobre mí | Agustina Ferraro">
  <Navbar seccionActiva="sobre-mi" />
  <main class="pt-16">
    <div class="max-w-6xl mx-auto px-4 pt-8">
      <BackButton href="/" />
    </div>
    <SeccionSobreMi />
  </main>
  <Footer />
</Layout>