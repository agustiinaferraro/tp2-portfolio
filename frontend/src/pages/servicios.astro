---
//pagina "servicios": listado de todos los servicios (reusa la seccion del home)
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BackButton from '../components/BackButton.astro';
import SeccionServicios from '../components/SeccionServicios.astro';
---

<Layout title="Servicios | Agustina Ferraro">
  <Navbar seccionActiva="servicios" />
  <main class="pt-16">
    <div class="max-w-6xl mx-auto px-4 pt-8">
      <BackButton href="/" />
    </div>
    <SeccionServicios />
  </main>
  <Footer />
</Layout>