# Copiá este archivo a .env y completá los valores reales
# (nunca subas el archivo .env real a Git)

# Puerto donde corre el servidor
PORT=4000

# Cadena de conexión a MongoDB Atlas
# La obtenés creando un cluster en https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<basededatos>
